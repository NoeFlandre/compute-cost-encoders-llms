# syntax=docker/dockerfile:1.7

ARG CUDA_VERSION=13.0.0
ARG UBUNTU_VERSION=24.04
ARG LLAMA_CPP_REVISION=6503355df0eb4f65875012523263c302fe0088c1

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION} AS llama-build
ARG LLAMA_CPP_REVISION

RUN apt-get update \
    && apt-get install --no-install-recommends -y build-essential ca-certificates cmake git \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/ggml-org/llama.cpp.git /tmp/llama.cpp \
    && git -C /tmp/llama.cpp checkout "${LLAMA_CPP_REVISION}"
RUN cmake -S /tmp/llama.cpp -B /tmp/llama.cpp/build \
    -DGGML_CUDA=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=ON \
    && cmake --build /tmp/llama.cpp/build --target llama-server --parallel 2

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh

ENV PATH="/root/.local/bin:${PATH}"

COPY --from=llama-build /tmp/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server

WORKDIR /workspace
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --locked --extra benchmark --no-dev
COPY configs ./configs
COPY scripts ./scripts

ENV LLAMA_SERVER_BIN=/usr/local/bin/llama-server \
    HF_HOME=/tmp/compute-cost-encoders-llms-huggingface \
    UV_CACHE_DIR=/tmp/compute-cost-encoders-llms-uv

CMD ["uv", "run", "--locked", "python", "-m", "compute_cost_encoders_llms.benchmark.cli", "--help"]
